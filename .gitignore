.claude/
*.log
Thumbs.db
.DS_Store

assets/incoming/

# программа для ПК: зависимости, собранная игра, установщики
desktop/node_modules/
game-manifest.json
desktop/game/
desktop/dist/
server/node_modules/
server/data/

# рекламный ролик: кадры, отрендеренные клипы, зависимости Remotion
promo/frames/
promo/shots/
promo/video/node_modules/
promo/video/out/
promo/check/
promo/video/public/shots/
promo/video/public/audio/
promo/video/public/music/
promo/audio/
promo/music-preview/
promo/shots2/
promo/video/public2/
# ролики-петли и снимки для сайта (большие файлы — выкладываются на сервер, не в git)
site_media/
# видео и снимки нового сайта (~80 МБ) — собирает python -I deploy/build_site_media.py из site_media и съёмок
site/media/

# движок Godot и рабочие файлы проверок (всё на диске D)
tools/
.work/

# собранная игра Godot (deploy/build_game.sh): exe и .pck — только на сервер, не в git
# (с косой чертой — только папка в корне: desktop/build/ с installer.nsh и значком должна попасть в git)
/build/
# номер сборки для Mac: его на время сборки кладёт deploy/build_game.sh mac (в набор «macOS»), потом убирает
godot/mac_build.txt

# ключ подписи описи игры (deploy/game_manifest.js): только на компьютере владельца — не в git и не на сервер
/secrets/

# Synty POLYGON (куплено владельцем): исходные модели нельзя выкладывать — только локально, в собранную игру попадают
godot/assets/synty/
# Synty POLYGON Meadow Forest (куплено владельцем 13.11): тоже только локально — копия assets/incoming/synty/meadow (без лишнего)
godot/assets/synty_meadow/

# сохранения игры (Godot)
saves/
godot/research_tmp/
roblox/build/
/backups/

# задания для Cowork: результаты и картинки-образцы не в git (большие), сами задания — в git
/cowork/out/
/cowork/refs/

# форт: первые GLB с картинками Synty внутри — не коммитим (v2/ — без картинок)
godot/assets/fort/*.glb
godot/assets/fort/fort_manifest.json
godot/assets/fort/*.png
# значки построек, нарисованные заранее (deploy/build_game.sh, шаг 0) — снимки моделей Synty, не в git
godot/icons_prebuilt/

# Звуки боя из набора Sonniss GDC: лицензия разрешает их в игре, но не раздавать файлами — только локально,
# в собранную игру попадают (deploy/build_game.sh собирает из этой папки). Файлы с Викисклада (CC0) — в git.
godot/assets/sfx/battle2/*.ogg
godot/assets/sfx/battle2/*.ogg.import
