; Engine configuration file.
; CivCity — витрина нового мира на Godot 4

config_version=5

[application]

config/name="CivCity"
config/description="Римский город: уютная стройка как в Town to City, мир и дома в духе Synty"
run/main_scene="res://main.tscn"
config/version="1.0.0"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/ai/app_icon.png"
boot_splash/bg_color=Color(0.169, 0.114, 0.071, 1)
boot_splash/image="res://assets/ui/ai/app_icon.png"
boot_splash/stretch_mode=0
; собранная игра (не редактор): свои данные Godot (журналы, кэш шейдеров) — в %APPDATA%/CivCity Game
config/use_custom_user_dir.template=true
config/custom_user_dir_name.template="CivCity Game"

[autoload]

; первой: в собранной игре подключает файлы с моделями, музыкой и интерфейсом (scripts/packs.gd)
Packs="*res://scripts/packs.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
environment/ssao/quality=3
global_illumination/sdfgi/probe_ray_count=2
textures/default_filters/anisotropic_filtering_level=4
; сборка для Mac (Intel + Apple M одним приложением) без этого не экспортируется. Сжатых VRAM-картинок у игры нет
; (Synty — Basis, остальное — без потерь), поэтому импорт не меняется, а наборы Windows не растут (проверено 28.10)
textures/vram_compression/import_etc2_astc=true
