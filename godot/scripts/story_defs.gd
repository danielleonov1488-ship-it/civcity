## Проверки добавляют сюда свои истории (другие виды целей), игра — не трогает
static var extra: Array = []


static func all() -> Array:
	return STORIES + extra


static func story(id: String) -> Dictionary:
	for s: Dictionary in all():
		if String(s["id"]) == id:
			return s
	return {}


## История, что открывает это украшение («s_cat»; и то, что даёт другой выбор — «s_fair_wine»), или {}
static func by_unlock(u: String) -> Dictionary:
	for s: Dictionary in all():
		var r: Dictionary = s.get("reward", {})
		if String(r.get("unlock", "")) == u:
			return s
		for ch in (r.get("by_choice", {}) as Dictionary):
			if String((r["by_choice"][ch] as Dictionary).get("unlock", "")) == u:
				return s
	return {}


## Первое слово семьи: «Юлии Максимы» → «Юлии»
static func _fam1(fam: String) -> String:
	return fam.get_slice(" ", 0)


## «Корнелии» → «Корнелиев», «Помпеи» → «Помпеев»
static func fam_gen(fam: String) -> String:
	var f := _fam1(fam)
	return (f.left(f.length() - 1) + "ев") if f.ends_with("и") else f


## «Корнелии» → «Корнелий», «Помпеи» → «Помпей»
static func nomen(fam: String) -> String:
	var f := _fam1(fam)
	return (f.left(f.length() - 1) + "й") if f.ends_with("и") else f


## Имя мальчика из семьи (по имени семьи — всегда одно и то же)
static func boy(fam: String) -> String:
	var h := 0
	for i in fam.length():
		h = (h * 31 + fam.unicode_at(i)) % 100003
	return BOYS[h % BOYS.size()]


## Имя старика из семьи (не то, что у мальчика той же семьи)
static func elder(fam: String) -> String:
	return boy(fam + "·дед")


## Имя отца семьи (не то, что у мальчика и деда той же семьи — как получится по имени семьи)
static func father(fam: String) -> String:
	return boy(fam + "·отец")


## «Корнелии» → «Корнелия», «Помпеи» → «Помпея» (так звали римлянок — по роду)
static func nomen_f(fam: String) -> String:
	var f := _fam1(fam)
	return (f.left(f.length() - 1) + "я") if f.ends_with("и") else f


## Подставить имена: {kid}, {elder}, {father}, {nomen}, {nomen_f}, {fam_gen}, {nomen2}, {fam2_gen}, {cat}, {ref.история.поле}
static func fill(text: String, bind: Dictionary) -> String:
	var fam := String(bind.get("fam", ""))
	var fam2 := String(bind.get("fam2", ""))
	if text.contains("{ref."):
		var refs: Dictionary = bind.get("refs", {})
		for sid in refs:
			for k in refs[sid]:
				text = text.replace("{ref.%s.%s}" % [sid, k], String(refs[sid][k]))
	if text.contains("{hero}") or text.contains("{job}") or text.contains("{a}"):
		# герой-житель (этап 6.10): имя из записи члена семьи, кем работает, «а» — если героиня
		var fem := bool(bind.get("female", false))
		text = text.replace("{hero}", String(bind.get("hero", bind.get("kid", "")))).replace("{a}", "а" if fem else "") \
			.replace("{job}", String(bind.get("job_n", "жительница" if fem else "житель")))
	return text.replace("{kid}", String(bind.get("kid", ""))).replace("{elder}", elder(fam)).replace("{father}", father(fam)) \
		.replace("{nomen2}", nomen(fam2)).replace("{fam2_gen}", fam_gen(fam2)).replace("{nomen_f}", nomen_f(fam)).replace("{nomen}", nomen(fam)) \
		.replace("{fam_gen}", fam_gen(fam)).replace("{cat}", String(bind.get("cat_name", "Мася")))


## Старые сохранения (решение владельца Д15): «Где Мурка?» стала «Где Мася?» — чёрную кошку Масю ищет девушка Мария.
## Пройденная, идущая и предложенная история «cat» — с новыми именами и обликом (журнал, «Пересмотреть», облачко),
## кошка-награда «Мурка» — теперь чёрная Мася, строка счастья дома — «Мася снова дома». Второй раз ничего не меняет
const OLD_CAT := "Мурка"


static func migrate(s: Dictionary) -> void:
	var sd := story("cat")
	if sd.is_empty():
		return
	var fo := find_opts(sd)
	var nm := String(fo.get("name", "Мася"))
	var fur := int(fo.get("fur", 0))
	var r0: Dictionary = (sd.get("cast", {}) as Dictionary).values()[0]
	var hero := String(r0.get("name", ""))
	var es := []
	if typeof(s.get("done")) == TYPE_DICTIONARY and typeof(s["done"].get("cat")) == TYPE_DICTIONARY:
		es.append(s["done"]["cat"])
	for k in ["active", "offer"]:
		if typeof(s.get(k)) == TYPE_DICTIONARY and String(s[k].get("id", "")) == "cat":
			es.append(s[k])
	for e: Dictionary in es:
		if hero != "":
			e["kid"] = hero
		e["female"] = bool(r0.get("female", false))
		e["child"] = bool(r0.get("child", false))
		if e.has("cat_name"):
			e["cat_name"] = nm
		if e.has("fur"):
			e["fur"] = fur
		# строка журнала: «Луций сам нашёл Мурку…» — заново по нынешнему тексту, награда — как была
		var t := String(e.get("text", ""))
		if t.contains(OLD_CAT.left(4)):
			var i := t.find("Награда:")
			var head := fill(String(goal_step(sd, "find").get("giveup", "")), e) if String(e.get("how", "")) == "self" else ""
			e["text"] = (head + " " if head != "" else "") + (t.substr(i) if i >= 0 else "")
	for p in s.get("pets", []):
		if typeof(p) == TYPE_DICTIONARY and String(p.get("name", "")) == OLD_CAT:
			p["name"] = nm
			p["fur"] = fur
	for b in s.get("bonus", []):
		if typeof(b) == TYPE_DICTIONARY and String(b.get("id", "")) == "cat":
			b["line"] = String(sd.get("line", b.get("line", "")))


## Д15: старые строки колокольчика из «Где Мурка?» (просьба «Маленький Луций… расстроен», «сам нашёл Мурку», «завершена»,
## «для истории «Где Мурка?»») — с новыми именами (Мария, Мася) и значком чёрной кошки; второй раз ничего не меняет
static func migrate_events(evs: Array) -> void:
	var sd := story("cat")
	if sd.is_empty():
		return
	var hero := String(((sd.get("cast", {}) as Dictionary).values()[0] as Dictionary).get("name", ""))
	var re_ask := RegEx.create_from_string("^Маленький \\S+ из семьи (.+?) чем-то расстроен — над их домом свиток с просьбой\\.")
	var re_self := RegEx.create_from_string("\\S+ сам нашёл Мурку — она дремала в укромном уголке\\. Кошка снова дома\\.")
	var self_new := fill(String(goal_step(sd, "find").get("giveup", "")), {"kid": hero})
	for e in evs:
		if typeof(e) != TYPE_DICTIONARY:
			continue
		var t0 := String(e.get("text", ""))
		var t := t0
		var m := re_ask.search(t)
		if m != null:
			t = fill(String(sd.get("ask", "")).replace("{fam_gen}", m.get_string(1)), {"kid": hero}) + t.substr(m.get_end())
		if t.contains(OLD_CAT.left(4)):
			t = t.replace("«Где Мурка?»", "«%s»" % String(sd["title"]))
			var ms := re_self.search(t)
			if ms != null:
				t = t.left(ms.get_start()) + self_new + t.substr(ms.get_end())
			t = t.replace("Муркой", "Масей").replace("Мурку", "Масю").replace("Мурке", "Масе").replace("Мурки", "Маси").replace(OLD_CAT, "Мася")
		if t == t0:
			continue
		e["text"] = t
		if String(e.get("icon", "")) == "cat":
			e["icon"] = String(sd.get("icon", "cat"))


## Что пройденная история может сказать другим ({ref.история.поле}): имена её семьи
static func ref_of(e: Dictionary) -> Dictionary:
	var fam := String(e.get("fam", ""))
	return {"elder": "%s %s" % [elder(fam), nomen(fam)], "nomen": nomen(fam), "fam_gen": fam_gen(fam), "kid": String(e.get("kid", ""))}


## Название истории: с именем семьи, если оно известно («Тесно у Корнелиев»), иначе обычное
static func title_of(s: Dictionary, bind: Dictionary = {}) -> String:
	if s.has("title_f") and String(bind.get("fam", "")) != "":
		return fill(String(s["title_f"]), bind)
	return String(s.get("title", ""))


## Шаг с целью kind (первый) — или {}
static func goal_step(s: Dictionary, kind: String) -> Dictionary:
	for st: Dictionary in s.get("steps", []):
		var g: Array = st.get("goal", [])
		if not g.is_empty() and String(g[0]) == kind:
			return st
	return {}


## Шаг истории с целью find (что ищем и как) — или {}
static func find_opts(s: Dictionary) -> Dictionary:
	for st: Dictionary in s.get("steps", []):
		var g: Array = st.get("goal", [])
		if not g.is_empty() and String(g[0]) == "find":
			return g[2]
	return {}


## Что ищут в истории: «cat», «donkey» (или "" — поисков нет)
static func find_what(s: Dictionary) -> String:
	for st: Dictionary in s.get("steps", []):
		var g: Array = st.get("goal", [])
		if not g.is_empty() and String(g[0]) == "find":
			return String(g[1])
	return ""


## Цель «щёлкнуть по местам» истории (лужи) — или []
static func click_goal(s: Dictionary) -> Array:
	for st: Dictionary in s.get("steps", []):
		var g: Array = st.get("goal", [])
		if not g.is_empty() and String(g[0]) == "click":
			return g
	return []


## Цель «лавка у дома торгует» истории (ослик) — или []
static func works_goal(s: Dictionary) -> Array:
	for st: Dictionary in s.get("steps", []):
		var g: Array = st.get("goal", [])
		if not g.is_empty() and String(g[0]) == "works":
			return g
	return []
