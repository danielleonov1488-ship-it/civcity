# Caddy раздаёт игру и пропускает /api к серверу CivCity (127.0.0.1:3000).
# civcity.ru — по HTTPS: сертификат Caddy получает и продлевает сам (пока домен не виден в интернете,
# он просто повторяет попытки). www.civcity.ru перенаправляет на civcity.ru.
# По адресу сервера (http://159.194.249.20) игра тоже открывается — на случай, если с доменом что-то случится.

(game) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * /srv/civcity/www
		# браузер каждый раз сверяет файлы с сервером (быстро, через ETag), поэтому обновления видны сразу
		header Cache-Control "no-cache"
		header /download/* Cache-Control "public, max-age=3600"
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

civcity.ru {
	import game
}

www.civcity.ru {
	redir https://civcity.ru{uri} permanent
}

http://159.194.249.20 {
	import game
}
