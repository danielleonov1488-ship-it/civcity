# Caddy раздаёт сайт и игру для лаунчера и пропускает /api к серверу CivCity (127.0.0.1:3000).
# civcity.ru — по HTTPS: сертификат Caddy получает и продлевает сам. www.civcity.ru перенаправляет на civcity.ru.
# По адресу сервера (http://159.194.249.20) всё тоже открывается — на случай, если с доменом что-то случится.
#
#   /api/*     → сервер аккаунтов (вход, сохранения городов в облаке, новости лаунчера)
#   /game/*    → /srv/civcity/game: опись игры manifest.json и файлы игры f/<sha256>[.zst] (их выкладывает deploy.sh),
#                mac.json — какая сборка для Mac свежая и какая обязательна (deploy.sh mac)
#   остальное  → /srv/civcity/www: сайт, установщики и архив для Mac в /download/, game-manifest.json для лаунчеров 0.9.x

{
	# сертификаты — от Let's Encrypt (у запасного ZeroSSL в этой версии Caddy сломан вход)
	email noreply@civcity.ru
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	# без HTTP/3 (QUIC): у части провайдеров он режется или зависает посреди загрузки, и лаунчер
	# ждёт впустую; обычные HTTP/1.1 и HTTP/2 работают везде и не медленнее
	servers {
		protocols h1 h2
	}
}

(game) {
	# сжатие — для страниц, стилей, описей; файлы игры (game/f/*) уже сжаты или не сжимаются,
	# и отдаются как есть — так работает докачка с места обрыва (Range)
	@compress not path /game/f/*
	encode @compress zstd gzip

	@blob path /game/f/*
	@meta not path /game/f/*
	@download path /download/*
	@zip path /download/*.zip
	@page not path /download/*

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle /game/* {
		root * /srv/civcity
		# у файла по содержимому адрес навсегда связан с содержимым — можно хранить сколько угодно
		header @blob Cache-Control "public, max-age=31536000, immutable"
		# опись меняется с каждой выкладкой — каждый раз сверять
		header @meta Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv/civcity/www
		# страницы браузер каждый раз сверяет с сервером (быстро, через ETag) — обновления сайта видны сразу
		header @page Cache-Control "no-cache"
		header @download Cache-Control "public, max-age=3600"
		# архив для Mac (CivCity-mac.zip): тип — явно. Caddy берёт его из /etc/mime.types, а если там .zip нет —
		# не пишет никакого (сам не угадывает), и Safari может не узнать архив. Размер файла Caddy не ограничивает
		header @zip Content-Type "application/zip"
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

civcity.ru {
	import game
}

www.civcity.ru {
	redir https://civcity.ru{uri} permanent
}

http://159.194.249.20 {
	import game
}
